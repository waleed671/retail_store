APP_NAME="Local Retail Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pak_retail_store
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="store@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Store settings
STORE_PHONE="+92 300 0000000"
STORE_WHATSAPP="+92 300 0000000"
STORE_EMAIL="support@example.com"
STORE_ADDRESS="Main Bazaar Road, Your City, Pakistan"
STORE_CURRENCY=PKR
STORE_SHIPPING_FLAT_FEE=200
STORE_FREE_SHIPPING_THRESHOLD=5000

# Bank transfer details (shown at checkout as an alternative to COD)
STORE_BANK_NAME="Meezan Bank"
STORE_BANK_ACCOUNT_TITLE="Local Retail Store"
STORE_BANK_ACCOUNT_NUMBER="0000-0000-0000"
STORE_BANK_IBAN="PK00XXXX0000000000000000"
